{
  "name": "aura-harness",
  "version": "0.2.0-beta.6",
  "description": "Aura i terminalen: kodeagent, skills, godkendelser og lokale projekter",
  "license": "EUPL-1.2",
  "private": true,
  "bin": { "aura": "cli/aura.cjs" },
  "engines": { "node": ">=22.12.0" },
  "optionalDependencies": {
    "opencode-darwin-arm64": "1.19.3",
    "opencode-darwin-x64-baseline": "1.19.3",
    "opencode-windows-arm64": "1.19.3",
    "opencode-windows-x64-baseline": "1.19.3",
    "opencode-linux-arm64": "1.19.3",
    "opencode-linux-arm64-musl": "1.19.3",
    "opencode-linux-x64-baseline": "1.19.3",
    "opencode-linux-x64-baseline-musl": "1.19.3"
  },
  "files": ["cli/*.cjs", "cli/*.md", "desktop/core/*.cjs", "desktop/ui/conversation-mode.js", "desktop/ui/plan-view.js", "desktop/runtime-lock.json", "profiles/", "scripts/harness.cjs", "LICENSE"],
  "scripts": {
    "package:cli": "node scripts/build-cli-release.cjs",
    "test:cli": "node --test --test-concurrency=1 cli/tests/*.test.cjs",
    "test:cli-live": "node cli/tests/verify-cli.cjs"
  }
}
